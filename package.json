{
  "name": "koishi-plugin-yesimbot-extension-discord-reaction",
  "version": "1.0.0",
  "description": "YesImBot 扩展：Discord 表情回应（模型可调用 discord_add_reaction 工具为消息添加表情）",
  "homepage": "https://github.com/Leersxie/koishi-plugin-yesimbot-extension-discord-reaction",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Leersxie/koishi-plugin-yesimbot-extension-discord-reaction.git"
  },
  "keywords": [
    "koishi",
    "koishi-plugin",
    "yesimbot",
    "extension",
    "discord",
    "reaction",
    "表情回应"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib"
  ],
  "sideEffects": false,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "koishi": {
    "description": {
      "en": "YesImBot extension: add reactions to Discord messages via the discord_add_reaction tool.",
      "zh": "YesImBot 扩展：为 Discord 消息添加表情回应（discord_add_reaction 工具）。"
    },
    "service": {
      "required": [
        "yesimbot"
      ]
    }
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w --preserveWatchOutput",
    "clean": "node -e \"fs.rmSync('lib',{recursive:true,force:true})\""
  },
  "license": "MIT",
  "peerDependencies": {
    "koishi": "^4.18.7",
    "koishi-plugin-yesimbot": "^3.0.3"
  },
  "devDependencies": {
    "@koishijs/plugin-adapter-discord": "^4.6.1",
    "@types/node": "^20.19.0",
    "koishi": "^4.18.7",
    "koishi-plugin-yesimbot": "^3.0.3",
    "typescript": "^5.6.0"
  }
}
